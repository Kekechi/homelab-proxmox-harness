# Generated by scripts/generate-configs.py from config/sandbox.yml
# DO NOT EDIT the non-secret values — run `make configure` to regenerate.
# Fill in all CHANGE_ME secrets below manually. This is the single source for all secrets.
_envrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Proxmox — endpoint auto-populated from config, token is a secret
export PROXMOX_VE_ENDPOINT="https://10.20.0.1:8006"
export PROXMOX_VE_INSECURE="true"
export PROXMOX_VE_API_TOKEN="CHANGE_ME"  # e.g. terraform@pve!claude-sandbox=<uuid>

# MinIO credentials — root pair for Ansible/bootstrap, scoped pair for Terraform state
export MINIO_ROOT_USER="CHANGE_ME"  # MinIO root/admin username
export MINIO_ROOT_PASSWORD="CHANGE_ME"  # MinIO root/admin password
export MINIO_ACCESS_KEY="CHANGE_ME"  # scoped key (read/write tfstate bucket only) — written by bootstrap
export MINIO_SECRET_KEY="CHANGE_ME"  # scoped secret — written by bootstrap

# MinIO endpoint — derived from config; Terraform S3 backend + tooling
export MINIO_ENDPOINT="https://minio.lab.example.com:9000"

# step-ca PKI passwords — used by the pki component playbook
export STEP_CA_ROOT_PASSWORD="CHANGE_ME"  # password protecting the Root CA private key
export STEP_CA_ISSUING_PASSWORD="CHANGE_ME"  # password protecting the Issuing CA private key
export STEP_CA_LXC_ROOT_PASSWORD="CHANGE_ME"  # root account password for the Issuing CA LXC
export STEP_CA_PROVISIONER_PASSWORD="CHANGE_ME"  # JWK provisioner password (used by minio TLS setup)

# Nexus credentials — used by the nexus component playbook
export NEXUS_ADMIN_PASSWORD="CHANGE_ME"  # Nexus admin account password
export NEXUS_READER_PASSWORD="CHANGE_ME"  # nexus-reader account (read-only APT/artifact access)

# PowerDNS API keys — used by the dns component playbooks
export PDNS_AUTH_API_KEY="CHANGE_ME"  # Auth webserver/API key
export PDNS_RECURSOR_API_KEY="CHANGE_ME"  # Recursor webserver/API key
export PDNS_DNSDIST_API_KEY="CHANGE_ME"  # DNSdist webserver/API key

# OTel Collector credentials — used by the log_server component playbook
export OTELCOL_MINIO_ACCESS_KEY="CHANGE_ME"  # write-scoped key for otelcol-logs bucket
export OTELCOL_MINIO_SECRET_KEY="CHANGE_ME"  # write-scoped secret

# Splunk credentials — used by the splunk component playbook
export SPLUNK_ADMIN_PASSWORD="CHANGE_ME"  # admin account password
export SPLUNK_HEC_TOKEN="CHANGE_ME"  # HEC token UUID (generate with uuidgen); reuse in OTel config
export SPLUNK_MCP_PASSWORD="CHANGE_ME"  # mcp service account password

# Internal CA trust for the HTTPS MinIO state backend (minio.tls: true).
# Requires .pki/root_ca.crt to exist (PKI deployed).
export AWS_CA_BUNDLE="${_envrc_dir}/.pki/root_ca.crt"

# Internal CA trust — uncomment after PKI setup (.pki/root_ca.crt exists)
# Go (Terraform) and curl pick this up; no container rebuild needed.
# export SSL_CERT_FILE="${_envrc_dir}/.pki/root_ca.crt"

# Operator-local additions — never templated or merged by `make configure`.
# Machine-specific env and extra secrets belong in .envrc.local (gitignored).
if [ -f "${_envrc_dir}/.envrc.local" ]; then
    . "${_envrc_dir}/.envrc.local"
fi
unset _envrc_dir
