# Generated by scripts/generate-configs.py from config/sandbox.yml
# DO NOT EDIT — run `make configure` to regenerate. Agent-host facts (SSH key,
# extra ssh args) come from the config's agent: section.

[defaults]
inventory           = inventory/
roles_path          = roles/
collections_paths   = ~/.ansible/collections
remote_user         = ubuntu
private_key_file    = ~/.ssh/id_ed25519
host_key_checking   = True
retry_files_enabled = False
stdout_callback     = ansible.builtin.default
callback_result_format = yaml

[privilege_escalation]
become        = True
become_method = sudo

[ssh_connection]
pipelining = True
ssh_args = -o StrictHostKeyChecking=accept-new -o ControlMaster=auto -o ControlPersist=10m -o ConnectTimeout=30 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
