# Generated by scripts/generate-configs.py from config/sandbox.yml
# DO NOT EDIT — run `make configure` to regenerate.

pool_id                = "golden-pool"
datastore_id           = "disk0"
cloudinit_datastore_id = "disk0"
vm_id_range_start      = 300
ssh_public_key         = "ssh-ed25519 AAAATESTKEY golden"
domain_name            = "lab.example.com"

lxc_template_file_id = "tmpl:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"

root_ca_node    = "n1"
issuing_ca_node = "n1"
dns_auth_node   = "n1"
dns_dist_node   = "n1"
nexus_node      = "n1"

# Deployment gating — set services.<svc>.enabled: true in config to unlock each phase
enable_pki        = false
enable_dns        = false
enable_nexus      = false
enable_log_server = true
enable_splunk     = false

# DNS resolver injected into all LXC/VM initialization blocks
dns_servers = ["10.20.0.2"]

# PKI
root_ca_vm_id           = 311
root_ca_ipv4_address    = "10.20.30.11/24"
root_ca_ipv4_gateway    = "10.20.30.1"
root_ca_bridge          = "labbr"
issuing_ca_ct_id        = 312
issuing_ca_ipv4_address = "10.20.30.12/24"
issuing_ca_ipv4_gateway = "10.20.30.1"
issuing_ca_bridge       = "labbr"
cloud_init_template_id  = 9000

# DNS
dns_auth_ct_id        = 313
dns_auth_ipv4_address = "10.20.30.13/24"
dns_auth_ipv4_gateway = "10.20.30.1"
dns_auth_bridge       = "labbr"
dns_dist_ct_id        = 314
dns_dist_ipv4_address = "10.20.30.14/24"
dns_dist_ipv4_gateway = "10.20.30.1"
dns_dist_bridge       = "labbr"

# Nexus
nexus_ct_id        = 315
nexus_ipv4_address = "10.20.30.15/24"
nexus_ipv4_gateway = "10.20.30.1"
nexus_bridge       = "labbr"

# Log Server
log_server_node         = "n1"
log_server_ct_id        = 316
log_server_ipv4_address = "10.20.30.16/24"
log_server_ipv4_gateway = "10.20.30.1"
