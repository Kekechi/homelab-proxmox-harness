# Generated by scripts/generate-configs.py from config/sandbox.yml
# DO NOT EDIT — run `make configure` to regenerate.

pool_id                = "golden-pool"
datastore_id           = "disk0"
cloudinit_datastore_id = "disk0"
ssh_public_key         = "ssh-ed25519 AAAATESTKEY golden"

lxc_template_file_id = "tmpl:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"

# DNS resolver injected into all LXC/VM initialization blocks
dns_servers = ["10.20.0.2"]

# Terraform-managed guests — one entry per enabled component instance
# (kind: vm | lxc). Sizing comes from each component's manifest, with
# per-env overrides via services.<name>.resources in config.
services = {
  root_ca = {
    kind              = "vm"
    node              = "n1"
    id                = 311
    name              = "root-ca"
    bridge            = "labbr"
    ipv4_address      = "10.20.30.11/24"
    ipv4_gateway      = "10.20.30.1"
    cores             = 1
    memory_mb         = 512
    disk_size_gb      = 8
    started           = false
    start_on_boot     = false
    agent_enabled     = false
    clone_template_id = 9000
  }
  issuing_ca = {
    kind         = "lxc"
    node         = "n1"
    id           = 312
    name         = "issuing-ca"
    bridge       = "labbr"
    ipv4_address = "10.20.30.12/24"
    ipv4_gateway = "10.20.30.1"
    cores        = 1
    memory_mb    = 512
    disk_size_gb = 8
  }
  nexus = {
    kind           = "lxc"
    node           = "n1"
    id             = 315
    name           = "nexus-server"
    bridge         = "labbr"
    ipv4_address   = "10.20.30.15/24"
    ipv4_gateway   = "10.20.30.1"
    cores          = 2
    memory_mb      = 8192
    disk_size_gb   = 8
    data_disk_size = "20G"
    data_disk_path = "/mnt/nexus-data"
  }
  dns_auth = {
    kind         = "lxc"
    node         = "n1"
    id           = 313
    name         = "dns-auth"
    bridge       = "labbr"
    ipv4_address = "10.20.30.13/24"
    ipv4_gateway = "10.20.30.1"
    cores        = 1
    memory_mb    = 512
    disk_size_gb = 8
  }
  dns_dist = {
    kind         = "lxc"
    node         = "n1"
    id           = 314
    name         = "dns-dist"
    bridge       = "labbr"
    ipv4_address = "10.20.30.14/24"
    ipv4_gateway = "10.20.30.1"
    cores        = 1
    memory_mb    = 512
    disk_size_gb = 8
  }
  log_server = {
    kind         = "lxc"
    node         = "n1"
    id           = 316
    name         = "log-server"
    bridge       = "labbr"
    ipv4_address = "10.20.30.16/24"
    ipv4_gateway = "10.20.30.1"
    cores        = 1
