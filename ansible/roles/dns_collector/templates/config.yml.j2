# Managed by Ansible — do not edit manually
global:
  server-identity: "dns-collector"
  trace:
    verbose: false

pipelines:
  - name: "tap"
    dnstap:
      listen-ip: "{{ dns_collector_dnstap_listen_ip }}"
      listen-port: {{ dns_collector_dnstap_listen_port }}
      tls-support: false
    routing-policy:
      forward: ["syslog-out"]

  - name: "syslog-out"
    syslog:
      transport: tcp
      remote-address: "{{ dns_collector_syslog_endpoint }}:{{ dns_collector_syslog_port }}"
      formatter: rfc5424
      mode: json
